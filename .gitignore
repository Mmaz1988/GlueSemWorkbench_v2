# Created by .ignore support plugin (hsz.mobi)
### Java template
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
# *.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
*.iml
*.xml
# ... but the build's own resources are source, not IDE noise. Without this,
# src/main/resources/logback-spring.xml is silently untracked (pom.xml only
# survives because it was added before the *.xml rule).
!src/main/resources/*.xml
.idea
stanford-corenlp-full-2017-06-09/

*.md
!**./docs/*